APP_NAME=UniTrack API
APP_ENV=development
APP_VERSION=0.1.0
HTTP_HOST=0.0.0.0
HTTP_PORT=8080
HTTP_READ_TIMEOUT=10s
HTTP_WRITE_TIMEOUT=10s
HTTP_IDLE_TIMEOUT=60s
HTTP_SHUTDOWN_TIMEOUT=10s
CORS_ALLOWED_ORIGINS=http://localhost:5173
# Set this in hosted deployments to the CIDR ranges or IPs of the trusted proxy/load balancer.
# Forwarded client IP headers are ignored unless the direct remote address matches this list.
# TRUSTED_PROXY_CIDRS=127.0.0.1/32
SESSION_SECURE=false
SESSION_SAME_SITE=lax
UPLOAD_STORAGE_BACKEND=local
UPLOAD_STORAGE_DIR=var/uploads
# Production evidence storage uses Cloudflare R2 through the S3-compatible API.
# APP_ENV=production requires UPLOAD_STORAGE_BACKEND=r2 and complete R2 settings.
# UPLOAD_STORAGE_BACKEND=r2
# R2_BUCKET=unitrack-evidence
# R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# R2_ACCESS_KEY_ID=<r2-access-key-id>
# R2_SECRET_ACCESS_KEY=<r2-secret-access-key>
# R2_REGION=auto
# R2_OBJECT_PREFIX=
# Local compose uses this connection string.
# The API does not load this file automatically; export these vars or use `make api-run-local`.
DATABASE_URL=postgres://postgres:postgres@localhost:55432/unitrack?sslmode=disable
# Development bootstrap credentials only. Production requires a 16+ character secret
# with uppercase, lowercase, number, and symbol characters.
AUTH_BOOTSTRAP_ADMIN_EMAIL=admin@unitrack.local
AUTH_BOOTSTRAP_ADMIN_PASSWORD=admin12345
