@startuml
!include includes/report-style.iuml
skinparam monochrome false
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam componentStyle rectangle
skinparam linetype ortho
skinparam defaultFontSize 18
skinparam Nodesep 42
skinparam Ranksep 58
top to bottom direction

skinparam node {
  BorderColor #1F2937
  FontColor #111827
}

actor "Admin / teacher / student\nbrowser" as Browser #DBEAFE

node "Vercel\nfrontend hosting" as Vercel #E0F2FE {
  component "Global CDN" as CDN #BFDBFE
  component "React SPA\nVite build" as SPA #DBEAFE
}

node "Render\nGo API service" as Render #DCFCE7 {
  component "HTTPS router" as Router #BBF7D0
  component "Go API\n/api/v1 + file stream" as API #D1FAE5
  component "startup config guard\nstrict env parsing" as Guard #FEF3C7
}

database "Neon PostgreSQL\ntransactions, locks, triggers" as Neon #FDE68A
cloud "Cloudflare R2\nprivate evidence bucket" as R2 #FED7AA

rectangle "Required production settings" as Settings #F5F3FF {
  component "Exact HTTPS\nCORS origins" as CORS #EDE9FE
  component "SESSION_SECURE=true\nSameSite=None" as Cookie #DDD6FE
  component "UPLOAD_STORAGE_BACKEND=r2\nno local disk" as StorageRule #C4B5FD
}

Browser --> CDN : HTTPS page load
CDN --> SPA : static assets
SPA --> Router : REST + HttpOnly cookie
Router --> API : route to Go server
Guard --> API : validate before serving
API --> Neon : SQL queries + migrations
API --> R2 : upload / download objects
Settings --> Guard : env policy

note bottom of Render
  First launch stays single-instance.
  Vercel already provides the frontend CDN;
  Render already provides HTTPS routing for the API.
end note
@enduml
