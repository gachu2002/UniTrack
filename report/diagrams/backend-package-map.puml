@startdot
digraph G {
  graph [rankdir=TB, bgcolor="white", margin=0.03, pad=0.08, nodesep=0.56, ranksep=0.58, splines=ortho, outputorder=edgesfirst, newrank=true];
  node [shape=plain, fontname="DejaVu Sans", fontsize=13, margin=0];
  edge [color="#111111", penwidth=0.95, arrowsize=0.62, fontname="DejaVu Sans", fontsize=10, fontcolor="#111111"];

  boot [label=<
    <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8" COLOR="#111111">
      <TR><TD BGCOLOR="#F2F2F2"><B>Boot</B></TD></TR>
      <TR><TD ALIGN="LEFT">cmd/server</TD></TR>
      <TR><TD ALIGN="LEFT">internal/config</TD></TR>
      <TR><TD ALIGN="LEFT">startup and shutdown</TD></TR>
    </TABLE>
  >];

  boundary [label=<
    <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8" COLOR="#111111">
      <TR><TD BGCOLOR="#F2F2F2"><B>Request boundary</B></TD></TR>
      <TR><TD ALIGN="LEFT">server.go route registration</TD></TR>
      <TR><TD ALIGN="LEFT">auth/security middleware</TD></TR>
      <TR><TD ALIGN="LEFT">response.go strict JSON/errors</TD></TR>
    </TABLE>
  >];

  handlers [label=<
    <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8" COLOR="#111111">
      <TR><TD BGCOLOR="#F2F2F2"><B>Feature handlers</B></TD></TR>
      <TR><TD ALIGN="LEFT">Projects, folders, members</TD></TR>
      <TR><TD ALIGN="LEFT">Milestones, tasks, reviews</TD></TR>
      <TR><TD ALIGN="LEFT">Resources, files, admin</TD></TR>
    </TABLE>
  >];

  authz [label=<
    <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8" COLOR="#111111">
      <TR><TD BGCOLOR="#F2F2F2"><B>Authorization helpers</B></TD></TR>
      <TR><TD ALIGN="LEFT">permissions.go ACL checks</TD></TR>
      <TR><TD ALIGN="LEFT">Project row locks</TD></TR>
      <TR><TD ALIGN="LEFT">Lifecycle rechecks</TD></TR>
    </TABLE>
  >];

  data [label=<
    <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8" COLOR="#111111">
      <TR><TD BGCOLOR="#F2F2F2"><B>Database access</B></TD></TR>
      <TR><TD ALIGN="LEFT">internal/database pgx pool</TD></TR>
      <TR><TD ALIGN="LEFT">goose migrations</TD></TR>
      <TR><TD ALIGN="LEFT">raw SQL transactions</TD></TR>
    </TABLE>
  >];

  objectio [label=<
    <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8" COLOR="#111111">
      <TR><TD BGCOLOR="#F2F2F2"><B>File storage access</B></TD></TR>
      <TR><TD ALIGN="LEFT">storage.go adapter</TD></TR>
      <TR><TD ALIGN="LEFT">local filesystem in dev/tests</TD></TR>
      <TR><TD ALIGN="LEFT">R2 object store in production</TD></TR>
    </TABLE>
  >];

  runtime [label=<
    <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8" COLOR="#111111">
      <TR><TD BGCOLOR="#F2F2F2"><B>Runtime checks</B></TD></TR>
      <TR><TD ALIGN="LEFT">readiness checks</TD></TR>
      <TR><TD ALIGN="LEFT">startup/shutdown hooks</TD></TR>
    </TABLE>
  >];

  pg [shape=cylinder, label="PostgreSQL\nFK + trigger + SQL"];
  files [shape=cylinder, label="Private file store\nR2 or local filesystem"];

  boot -> boundary [label="boots API"];
  boundary -> handlers [label="dispatch"];
  handlers -> authz [label="authorize"];
  handlers -> data [label="query / mutate"];
  handlers -> objectio [label="upload / download"];
  authz -> data [label="row locks"];
  data -> pg [label="queries"];
  objectio -> files [label="object IO"];
  runtime -> data [label="probe"];

  { rank=same; authz; data; objectio; }
  { rank=same; pg; runtime; files; }
}
@enddot
