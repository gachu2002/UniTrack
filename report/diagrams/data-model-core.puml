@startdot
digraph G {
  graph [rankdir=TB, bgcolor="white", splines=ortho, nodesep=0.42, ranksep=0.56, pad=0.08, margin=0.02, outputorder=edgesfirst];
  node [shape=plain, fontname="DejaVu Sans", fontsize=16, margin=0];
  edge [fontname="DejaVu Sans", fontsize=10, color="#111111", fontcolor="#111111", arrowhead=none, penwidth=1.05];

  users [label=<
    <TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6">
      <TR><TD COLSPAN="2" BGCOLOR="#D9EAF7"><B>users</B></TD></TR>
      <TR><TD ALIGN="LEFT">id</TD><TD ALIGN="LEFT">PK</TD></TR>
      <TR><TD ALIGN="LEFT">email</TD><TD ALIGN="LEFT">UQ</TD></TR>
      <TR><TD ALIGN="LEFT">role, status</TD><TD ALIGN="LEFT">account gate</TD></TR>
    </TABLE>
  >];
  sessions [label=<
    <TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6">
      <TR><TD COLSPAN="2" BGCOLOR="#D9EAF7"><B>sessions</B></TD></TR>
      <TR><TD ALIGN="LEFT">id</TD><TD ALIGN="LEFT">PK</TD></TR>
      <TR><TD ALIGN="LEFT">user_id</TD><TD ALIGN="LEFT">FK</TD></TR>
      <TR><TD ALIGN="LEFT">token_hash</TD><TD ALIGN="LEFT">UQ</TD></TR>
    </TABLE>
  >];
  activity_logs [label=<
    <TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6">
      <TR><TD COLSPAN="2" BGCOLOR="#D9EAF7"><B>activity_logs</B></TD></TR>
      <TR><TD ALIGN="LEFT">id</TD><TD ALIGN="LEFT">PK</TD></TR>
      <TR><TD ALIGN="LEFT">actor_id</TD><TD ALIGN="LEFT">FK</TD></TR>
      <TR><TD ALIGN="LEFT">project_id</TD><TD ALIGN="LEFT">nullable FK</TD></TR>
    </TABLE>
  >];

  course_sections [label=<
    <TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6">
      <TR><TD COLSPAN="2" BGCOLOR="#D9EAD3"><B>course_sections</B></TD></TR>
      <TR><TD ALIGN="LEFT">id</TD><TD ALIGN="LEFT">PK</TD></TR>
      <TR><TD ALIGN="LEFT">owner_teacher_id</TD><TD ALIGN="LEFT">FK</TD></TR>
      <TR><TD ALIGN="LEFT">title, color</TD><TD ALIGN="LEFT">folder UI</TD></TR>
    </TABLE>
  >];
  course_section_projects [label=<
    <TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6">
      <TR><TD COLSPAN="2" BGCOLOR="#D9EAD3"><B>course_section<BR/>_projects</B></TD></TR>
      <TR><TD ALIGN="LEFT">id</TD><TD ALIGN="LEFT">PK</TD></TR>
      <TR><TD ALIGN="LEFT">course_section_id</TD><TD ALIGN="LEFT">FK</TD></TR>
      <TR><TD ALIGN="LEFT">project_id</TD><TD ALIGN="LEFT">FK + UQ</TD></TR>
    </TABLE>
  >];
  projects [label=<
    <TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6">
      <TR><TD COLSPAN="2" BGCOLOR="#D9EAD3"><B>projects</B></TD></TR>
      <TR><TD ALIGN="LEFT">id</TD><TD ALIGN="LEFT">PK</TD></TR>
      <TR><TD ALIGN="LEFT">supervisor_id</TD><TD ALIGN="LEFT">FK</TD></TR>
      <TR><TD ALIGN="LEFT">status</TD><TD ALIGN="LEFT">lifecycle</TD></TR>
      <TR><TD ALIGN="LEFT">progress_state</TD><TD ALIGN="LEFT">rollup</TD></TR>
    </TABLE>
  >];
  project_members [label=<
    <TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6">
      <TR><TD COLSPAN="2" BGCOLOR="#D9EAD3"><B>project_members</B></TD></TR>
      <TR><TD ALIGN="LEFT">id</TD><TD ALIGN="LEFT">PK</TD></TR>
      <TR><TD ALIGN="LEFT">project_id</TD><TD ALIGN="LEFT">FK</TD></TR>
      <TR><TD ALIGN="LEFT">student_id</TD><TD ALIGN="LEFT">FK</TD></TR>
      <TR><TD ALIGN="LEFT">member_role</TD><TD ALIGN="LEFT">one leader</TD></TR>
    </TABLE>
  >];

  project_milestones [label=<
    <TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6">
      <TR><TD COLSPAN="2" BGCOLOR="#FFF2CC"><B>project<BR/>_milestones</B></TD></TR>
      <TR><TD ALIGN="LEFT">id</TD><TD ALIGN="LEFT">PK</TD></TR>
      <TR><TD ALIGN="LEFT">project_id</TD><TD ALIGN="LEFT">FK</TD></TR>
      <TR><TD ALIGN="LEFT">sort_order</TD><TD ALIGN="LEFT">plan order</TD></TR>
    </TABLE>
  >];
  tasks [label=<
    <TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6">
      <TR><TD COLSPAN="2" BGCOLOR="#FFF2CC"><B>tasks</B></TD></TR>
      <TR><TD ALIGN="LEFT">id</TD><TD ALIGN="LEFT">PK</TD></TR>
      <TR><TD ALIGN="LEFT">project_id</TD><TD ALIGN="LEFT">FK</TD></TR>
      <TR><TD ALIGN="LEFT">milestone_id</TD><TD ALIGN="LEFT">FK</TD></TR>
      <TR><TD ALIGN="LEFT">status, deadline</TD><TD ALIGN="LEFT">assignment</TD></TR>
    </TABLE>
  >];
  task_assignees [label=<
    <TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6">
      <TR><TD COLSPAN="2" BGCOLOR="#FFF2CC"><B>task<BR/>_assignees</B></TD></TR>
      <TR><TD ALIGN="LEFT">id</TD><TD ALIGN="LEFT">PK</TD></TR>
      <TR><TD ALIGN="LEFT">project_id, task_id</TD><TD ALIGN="LEFT">FK</TD></TR>
      <TR><TD ALIGN="LEFT">student_id</TD><TD ALIGN="LEFT">FK</TD></TR>
    </TABLE>
  >];
  progress_updates [label=<
    <TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6">
      <TR><TD COLSPAN="2" BGCOLOR="#FFF2CC"><B>progress<BR/>_updates</B></TD></TR>
      <TR><TD ALIGN="LEFT">id</TD><TD ALIGN="LEFT">PK</TD></TR>
      <TR><TD ALIGN="LEFT">project_id, task_id</TD><TD ALIGN="LEFT">FK</TD></TR>
      <TR><TD ALIGN="LEFT">submitted_by</TD><TD ALIGN="LEFT">FK</TD></TR>
      <TR><TD ALIGN="LEFT">review_status</TD><TD ALIGN="LEFT">pending UQ</TD></TR>
    </TABLE>
  >];
  progress_reviews [label=<
    <TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6">
      <TR><TD COLSPAN="2" BGCOLOR="#FFF2CC"><B>progress<BR/>_reviews</B></TD></TR>
      <TR><TD ALIGN="LEFT">id</TD><TD ALIGN="LEFT">PK</TD></TR>
      <TR><TD ALIGN="LEFT">progress_update_id</TD><TD ALIGN="LEFT">FK + UQ</TD></TR>
      <TR><TD ALIGN="LEFT">reviewed_by</TD><TD ALIGN="LEFT">FK</TD></TR>
    </TABLE>
  >];

  resource_links [label=<
    <TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6">
      <TR><TD COLSPAN="2" BGCOLOR="#F4CCCC"><B>resource_links</B></TD></TR>
      <TR><TD ALIGN="LEFT">id</TD><TD ALIGN="LEFT">PK</TD></TR>
      <TR><TD ALIGN="LEFT">project_id</TD><TD ALIGN="LEFT">FK</TD></TR>
      <TR><TD ALIGN="LEFT">related_entity_*</TD><TD ALIGN="LEFT">trigger</TD></TR>
    </TABLE>
  >];
  uploaded_files [label=<
    <TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6">
      <TR><TD COLSPAN="2" BGCOLOR="#F4CCCC"><B>uploaded_files</B></TD></TR>
      <TR><TD ALIGN="LEFT">id</TD><TD ALIGN="LEFT">PK</TD></TR>
      <TR><TD ALIGN="LEFT">project_id</TD><TD ALIGN="LEFT">FK</TD></TR>
      <TR><TD ALIGN="LEFT">related_entity_*</TD><TD ALIGN="LEFT">trigger</TD></TR>
      <TR><TD ALIGN="LEFT">storage_path</TD><TD ALIGN="LEFT">private file</TD></TR>
    </TABLE>
  >];

  subgraph cluster_identity {
    label="Tài khoản và audit";
    color="#AAB7C2";
    margin=16;
    users; sessions; activity_logs;
  }

  subgraph cluster_workspace {
    label="Workspace và dự án";
    color="#AAB7C2";
    margin=16;
    course_sections; course_section_projects; projects; project_members;
  }

  subgraph cluster_assignment {
    label="Kế hoạch, nhiệm vụ, bài nộp";
    color="#AAB7C2";
    margin=16;
    project_milestones; tasks; task_assignees; progress_updates; progress_reviews;
  }

  subgraph cluster_support {
    label="Tài nguyên và minh chứng";
    color="#AAB7C2";
    margin=16;
    resource_links; uploaded_files;
  }

  { rank=same; users; sessions; activity_logs; }
  { rank=same; course_sections; projects; project_members; }
  { rank=same; course_section_projects; project_milestones; tasks; task_assignees; }
  { rank=same; progress_updates; progress_reviews; resource_links; uploaded_files; }

  users -> sessions;
  users -> projects [label="supervisor"];
  users -> project_members [label="student"];
  users -> activity_logs [label="actor"];

  course_sections -> course_section_projects;
  projects -> course_section_projects;
  projects -> project_members;
  projects -> project_milestones;
  project_milestones -> tasks;
  tasks -> task_assignees;
  project_members -> task_assignees [style=dashed, label="same project", constraint=false];
  tasks -> progress_updates;
  progress_updates -> progress_reviews;

  projects -> resource_links;
  projects -> uploaded_files;
  progress_updates -> resource_links [style=dashed, label="submission target", constraint=false];
  progress_updates -> uploaded_files [style=dashed, label="submission file", constraint=false];
}
@enddot
