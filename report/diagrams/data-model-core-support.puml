  { rank=same; users; projects; }
  { rank=same; tasks; task_assignees; }
  { rank=same; progress_updates; progress_reviews; }
  { rank=same; legend; }

  users -> projects [style=dashed];
  projects -> tasks;
  tasks -> task_assignees;
  projects -> task_assignees;
  users -> task_assignees [style=dashed, constraint=false];
  tasks -> progress_updates;
  projects -> progress_updates;
  users -> progress_updates [style=dashed, constraint=false];
  progress_updates -> progress_reviews;
  users -> progress_reviews [style=dashed, constraint=false];
