@startuml
skinparam defaultFontName "DejaVu Sans"
skinparam backgroundColor white
skinparam shadowing false
skinparam componentStyle rectangle
skinparam ArrowColor #1A2B3C
skinparam ArrowFontSize 13
skinparam rectangle {
  BorderColor #AAB7C2
  FontColor #111111
}
skinparam actor {
  BorderColor #111111
  FontColor #111111
  BackgroundColor white
}
skinparam component {
  BorderColor #AAB7C2
  FontColor #111111
  FontSize 16
}
skinparam database {
  BorderColor #AAB7C2
  FontColor #111111
  FontSize 16
}
skinparam cloud {
  BorderColor #AAB7C2
  FontColor #111111
  FontSize 16
}

title Kiến trúc container tổng quan của UniTrack

rectangle "Người dùng\nAdmin / Teacher / Student" as User #F8FBFC

rectangle "Browser" #F8FBFC {
  component "React Web SPA\n- Protected routes\n- Role-aware pages\n- Query cache refresh" as Web #D9EAF7
}

rectangle "Go API /api/v1" #FFFDF6 {
  component "Middleware\n- Origin guard\n- Session cookie" as Middleware #FFF2CC
  component "Handlers\n- Strict JSON\n- Permission checks\n- Lifecycle transactions" as Handlers #FFF2CC
}

database "PostgreSQL\nProjects, tasks, submissions\nFK, unique index, triggers" as DB #D9EAD3
cloud "Private file storage\nLocal dev filesystem\nCloudflare R2 production" as Files #F4CCCC
rectangle "Runtime policy\nExact CORS origins\nSecure cookie settings\nPayload / upload limits" as Policy #E7E6E6

User --> Web : browser actions
Web --> Middleware : HTTPS JSON\nHttpOnly cookie
Middleware --> Handlers : authenticated request
Handlers --> DB : SQL transactions
Handlers --> Files : private upload / download
Policy ..> Web : session policy
Policy ..> Middleware : request policy
Policy ..> Files : upload limit
@enduml
