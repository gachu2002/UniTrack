@startuml
skinparam backgroundColor white
skinparam monochrome false
skinparam shadowing false
skinparam dpi 170
skinparam defaultFontName "DejaVu Sans"
skinparam defaultFontSize 14
skinparam defaultFontColor #0F172A
skinparam componentStyle uml2
skinparam packageStyle rectangle
skinparam linetype ortho
skinparam ArrowColor #334155
skinparam ArrowThickness 1.2
skinparam RoundCorner 12
skinparam Padding 4
skinparam Nodesep 32
skinparam Ranksep 38
skinparam package {
  BorderColor #94A3B8
  FontColor #0F172A
  FontStyle bold
}
skinparam component {
  BorderColor #475569
  FontColor #0F172A
}
skinparam database {
  BorderColor #6D28D9
  BackgroundColor #F5F3FF
  FontColor #2E1065
}
skinparam cloud {
  BorderColor #2563EB
  BackgroundColor #EFF6FF
  FontColor #1E3A8A
}
skinparam node {
  BorderColor #2563EB
  BackgroundColor #DBEAFE
  FontColor #1E3A8A
}
skinparam actor {
  BorderColor #2563EB
  BackgroundColor #EFF6FF
  FontColor #0F172A
}
skinparam note {
  BorderColor #CBD5E1
  BackgroundColor #F8FAFC
  FontColor #334155
}
top to bottom direction

actor "Quản trị viên" as Admin #DBEAFE
actor "Giảng viên" as Teacher #D1FAE5
actor "Sinh viên" as Student #FEF3C7
component "Cổng Web UniTrack\nđăng nhập + điều hướng Workspace" as Entry #E0F2FE

rectangle "Biên hệ thống UniTrack" as UniTrack #F8FAFC {
  package "Luồng nghiệp vụ chính" as Product #FFFBEB {
    component "Workspace\nThư mục + hồ sơ dự án" as Workspace #FEF3C7
    component "Work Plan\nMốc + assignment" as Plan #FDE68A
    component "Bài nộp\nTiến độ + minh chứng" as Submit #FDBA74
    component "Duyệt bài\nQuyết định cuối + khóa support" as Review #FCA5A5
  }

  package "Tầng trình diễn" as Presentation #EFF6FF {
    node "React SPA\nroute guard + layout" as Spa #DBEAFE
    component "Feature UI\nDashboard / Workspace\nProject / Assignment / Admin" as FeatureUi #BFDBFE
    component "Client state\nTanStack Query + Zustand" as ClientState #DBEAFE
  }

  package "Tầng ứng dụng" as Application #ECFDF5 {
    component "Go API\nchi router /api/v1" as Api #BBF7D0
    component "Request boundary\nCORS + session + strict JSON" as Boundary #A7F3D0
    component "Phân quyền\nrole + quan hệ dự án" as Authz #99F6E4
    component "Transaction guard\nrow lock + lifecycle recheck" as Tx #CCFBF1
    component "File service\nlocal hoặc R2 adapter" as FileSvc #D1FAE5
  }

  package "Tầng dữ liệu và toàn vẹn" as Data #F5F3FF {
    database "PostgreSQL\nnghiệp vụ + session" as Db #DDD6FE
    component "Ràng buộc DB\nFK + unique + trigger" as Integrity #EDE9FE
    cloud "Private evidence store\nCloudflare R2 hoặc local files" as ObjectStore #DBEAFE
  }
}

Admin --> Entry
Teacher --> Entry
Student --> Entry

Entry --> FeatureUi : HTTPS UI
FeatureUi --> Workspace : màn hình nghiệp vụ
Workspace --> Plan
Plan --> Submit
Submit --> Review

FeatureUi --> Spa : route + component
Spa --> ClientState : cache + auth state
Spa --> Api : REST JSON\nHttpOnly cookie
Api --> Boundary
Boundary --> Authz
Authz --> Tx
Tx --> Db : SQL transaction
Db --> Integrity : enforce invariant
Api --> FileSvc
FileSvc --> ObjectStore : upload / download
Review ..> Integrity : khóa support sau duyệt
@enduml
