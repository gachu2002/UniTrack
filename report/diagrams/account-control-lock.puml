@startuml
!include includes/report-style.iuml
skinparam backgroundColor white
skinparam shadowing false
skinparam defaultFontName "DejaVu Sans"
skinparam defaultFontSize 14
skinparam dpi 130
skinparam sequenceArrowThickness 1
skinparam ParticipantPadding 70
skinparam BoxPadding 7
skinparam maxMessageSize 86
hide footbox

actor "Admin" as Admin
participant "Admin UI" as AdminUI
participant "Account admin\nroute" as AccountRoute
participant "Auth/login\nroute" as LoginRoute
participant "Security\nchecks" as Security
database "PostgreSQL\nusers + sessions" as DB
actor "Concurrent\nlogin" as Concurrent

Admin -> AdminUI : Disable / activate / reset password
AdminUI -> AccountRoute : PATCH user or POST password reset
AccountRoute -> Security : Check admin session, role, origin
Security --> AccountRoute : admin principal
AccountRoute -> DB : BEGIN; advisory lock;\nlock actor + target; checks

group Concurrent login for same account
  Concurrent -> LoginRoute : POST /auth/login same email
  LoginRoute -> Security : Rate limit, origin, normalize email
  LoginRoute -> DB : SELECT target user FOR UPDATE;\nwait if row is locked
end

alt Admin mutation blocked
  DB --> AccountRoute : rollback + error reason
  AccountRoute --> AdminUI : Explain invariant failure
else Admin mutation accepted
  AccountRoute -> DB : UPDATE account; revoke sessions\nwhen needed; activity log; COMMIT
  AccountRoute --> AdminUI : Updated account state
end
@enduml
