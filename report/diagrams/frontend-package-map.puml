@startdot
digraph G {
  graph [rankdir=TB, bgcolor="white", margin=0.03, pad=0.08, nodesep=0.46, ranksep=0.64, splines=ortho, outputorder=edgesfirst];
  node [shape=plain, fontname="DejaVu Sans", fontsize=12, margin=0];
  edge [color="#111111", penwidth=0.95, arrowsize=0.62, fontname="DejaVu Sans", fontsize=10, fontcolor="#111111"];

  app [label=<
    <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8" COLOR="#111111">
      <TR><TD BGCOLOR="#F2F2F2"><B>App shell</B></TD></TR>
      <TR><TD ALIGN="LEFT">Router</TD></TR>
      <TR><TD ALIGN="LEFT">Protected layout</TD></TR>
      <TR><TD ALIGN="LEFT">Redirects and guards</TD></TR>
    </TABLE>
  >];

  features [label=<
    <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8" COLOR="#111111">
      <TR><TD BGCOLOR="#F2F2F2"><B>Feature pages</B></TD></TR>
      <TR><TD ALIGN="LEFT">Auth and dashboard</TD></TR>
      <TR><TD ALIGN="LEFT">Workspace and project pages</TD></TR>
      <TR><TD ALIGN="LEFT">Assignment and admin pages</TD></TR>
    </TABLE>
  >];

  presentation [label=<
    <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8" COLOR="#111111">
      <TR><TD BGCOLOR="#F2F2F2"><B>Shared presentation</B></TD></TR>
      <TR><TD ALIGN="LEFT">Layout components</TD></TR>
      <TR><TD ALIGN="LEFT">Forms, dialogs, empty/error states</TD></TR>
    </TABLE>
  >];

  data [label=<
    <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8" COLOR="#111111">
      <TR><TD BGCOLOR="#F2F2F2"><B>State and data access</B></TD></TR>
      <TR><TD ALIGN="LEFT">TanStack Query hooks</TD></TR>
      <TR><TD ALIGN="LEFT">API client and query keys</TD></TR>
      <TR><TD ALIGN="LEFT">Auth store and API types</TD></TR>
    </TABLE>
  >];

  api [shape=cylinder, label="Go API\n/api/v1"];

  app -> features [label="route render"];
  features -> presentation [label="compose UI"];
  features -> data [label="load / mutate"];
  data -> api [label="REST JSON + cookie"];
}
@enddot
