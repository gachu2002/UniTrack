@startuml
!include includes/report-style.iuml
skinparam backgroundColor white
skinparam shadowing false
skinparam defaultFontName "DejaVu Sans"
skinparam defaultFontSize 14
skinparam dpi 130
skinparam sequenceArrowThickness 1
skinparam ParticipantPadding 70
skinparam BoxPadding 7
skinparam maxMessageSize 84
hide footbox

actor "Sinh viên" as Student
participant "React\ntask page" as Web
participant "Task / progress\nroute" as Progress
participant "Resource / file\nroute" as FileRoute
database "PostgreSQL\ntransaction" as Tx
database "Object\nstorage" as Store

Student -> Web : Mở assignment page
Web -> Progress : GET task detail
Progress -> Tx : Check viewer; load task,\nassignees and history
Progress --> Web : Task + history
Web -> FileRoute : GET files/resources
FileRoute -> Tx : Load support records
FileRoute --> Web : Support records
Web --> Student : Render task + submit affordance

group Create pending submission
  Student -> Web : Gửi báo cáo tiến độ
  Web -> Progress : POST submit progress
  Progress -> Tx : BEGIN; lock project + task;\nrecheck assignee/lifecycle;\nensure no pending
  alt Student cannot submit
    Tx --> Progress : rollback + error reason
    Progress --> Web : Show validation error
  else Pending submission accepted
    Progress -> Tx : INSERT progress_update;\nset task=submitted; COMMIT
    Progress --> Web : pending id
  end
end

group Attach support while pending
  Student -> Web : Attach link/file evidence
  Web -> FileRoute : POST file/link evidence
  FileRoute -> Tx : Verify pending target + access
  opt File evidence
    FileRoute -> Store : Put private object
  end
  FileRoute -> Tx : Recheck; insert metadata;\nFK/trigger validate target
  FileRoute --> Web : Evidence visible while pending
end
@enduml
